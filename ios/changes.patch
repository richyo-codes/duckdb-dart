diff --git a/Makefile b/Makefile
index 1cb2d34a..55c8fcce 100644
--- a/Makefile
+++ b/Makefile
@@ -410,2 +410,19 @@ endif

+# Forward the mobile build settings supplied by duckdb-dart.
+ifneq ("${BUILD_TESTING}", "")
+	CMAKE_VARS:=${CMAKE_VARS} -DBUILD_TESTING='${BUILD_TESTING}'
+endif
+ifneq ("${BUILD_UNITTESTS}", "")
+	CMAKE_VARS:=${CMAKE_VARS} -DBUILD_UNITTESTS=${BUILD_UNITTESTS}
+endif
+ifneq ("${IOS_PLATFORM}", "")
+	CMAKE_VARS:=${CMAKE_VARS} -DIOS_PLATFORM='${IOS_PLATFORM}'
+endif
+ifneq ("${CMAKE_TOOLCHAIN_FILE}", "")
+	CMAKE_VARS_BUILD:=${CMAKE_VARS_BUILD} -DCMAKE_TOOLCHAIN_FILE='${CMAKE_TOOLCHAIN_FILE}'
+endif
+ifneq ("${BUILD_SHELL}", "")
+	CMAKE_VARS:=${CMAKE_VARS} -DBUILD_SHELL=${BUILD_SHELL}
+endif
+
 # Enable VCPKG for this build
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index fd3c7af8..f1c74808 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -113,2 +113,14 @@ endif()

+# Package the existing shared target as an iOS framework.
+if(IOS_PLATFORM)
+  configure_file(Info.plist.in ${CMAKE_CURRENT_BINARY_DIR}/Info.plist @ONLY)
+  set_target_properties(
+    duckdb PROPERTIES
+    FRAMEWORK TRUE
+    FRAMEWORK_VERSION A
+    MACOSX_FRAMEWORK_IDENTIFIER org.duckdb
+    MACOSX_FRAMEWORK_INFO_PLIST ${CMAKE_CURRENT_BINARY_DIR}/Info.plist
+    PUBLIC_HEADER "${PROJECT_SOURCE_DIR}/src/include/duckdb.h")
+endif()
+
 if(WIN32 AND NOT MINGW)
@@ -151,2 +163,4 @@ install(
   ARCHIVE DESTINATION "${INSTALL_LIB_DIR}"
-  RUNTIME DESTINATION "${INSTALL_BIN_DIR}")
+  RUNTIME DESTINATION "${INSTALL_BIN_DIR}"
+  FRAMEWORK DESTINATION "${INSTALL_LIB_DIR}"
+  PUBLIC_HEADER DESTINATION "${INSTALL_INCLUDE_DIR}")
